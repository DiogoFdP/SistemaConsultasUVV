@model GestaoConsultasUVV.Models.Consulta
@{
    ViewData["Title"] = "Editar Consulta";
}

<div class="row mt-4">
    <div class="col-md-6 offset-md-3">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Editar Consulta</h4>
            </div>
            <div class="card-body">
                <form asp-action="Editar">
                    <!-- O campo oculto (Hidden) é obrigatório para não perdermos o ID na hora de salvar -->
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Especialidade" class="form-label">Especialidade Médica</label>
                        <input asp-for="Especialidade" class="form-control" />
                        <span asp-validation-for="Especialidade" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataHora" class="form-label">Data e Hora</label>
                        <input asp-for="DataHora" type="datetime-local" class="form-control" />
                        <span asp-validation-for="DataHora" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label">Descrição (Opcional)</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>